{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node /opt/tlc/bin/tlc-exec.mjs --provider vscode session-start",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node /opt/tlc/bin/tlc-exec.mjs --provider vscode prompt-submit",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node /opt/tlc/bin/tlc-exec.mjs --provider vscode tool-before",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node /opt/tlc/bin/tlc-exec.mjs --provider vscode tool-after",
        "timeout": 10
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "node /opt/tlc/bin/tlc-exec.mjs --provider vscode subagent-start",
        "timeout": 5
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "node /opt/tlc/bin/tlc-exec.mjs --provider vscode subagent-stop",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node /opt/tlc/bin/tlc-exec.mjs --provider vscode stop",
        "timeout": 120
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node /opt/tlc/bin/tlc-exec.mjs --provider vscode compact-before",
        "timeout": 5
      }
    ]
  }
}
