{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "session-start"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "session-end"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "prompt-submit"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "tool-before"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "tool-after"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "tool-failure"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "subagent-start"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "subagent-stop"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "stop"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "compact-before"
            ]
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/opt/tlc/bin/tlc-exec.mjs",
              "response-after"
            ]
          }
        ]
      }
    ]
  }
}
