{
  "version": 1,
  "mode": "solo",
  "subagents": {
    "enforceAllowlist": false,
    "requireModel": true,
    "blockMode": "deny",
    "blockParentFast": false,
    "readOnlyTypes": [
      "explore"
    ]
  },
  "docs": {
    "command": null,
    "severity": "warn"
  },
  "comments": {
    "enabled": true,
    "onViolation": "followup",
    "mode": "declared"
  },
  "obs": {
    "globalSpool": false,
    "retentionDays": 14
  },
  "shell": {
    "catastrophicAsk": true,
    "stallDetection": true,
    "stallRepeatThreshold": 3
  },
  "intelligence": {
    "gapFeedback": true,
    "failureClassification": true,
    "progressiveHandoff": true,
    "progressiveContext": true,
    "autopilot": true,
    "budgetContinue": false,
    "budgetContinueAfterLoops": 3,
    "lessons": {
      "enabled": true,
      "maxInjectSession": 5,
      "maxInjectRetry": 8,
      "maxCharsSession": 900,
      "maxCharsRetry": 1400,
      "promoteHitCount": 2,
      "decayLambda": 0.02,
      "projectBoost": 1.5,
      "gardenOnSessionEnd": true
    }
  }
}
