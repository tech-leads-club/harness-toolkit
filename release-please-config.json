{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@tech-leads-club/harness-toolkit",
      "skip-changelog": true,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "exclude-paths": [
        ".github",
        "tools/dev",
        "tools/__test__",
        "docs/decisions",
        "CONTRIBUTING.md",
        "biome.json",
        "tsconfig.json",
        "install.sh",
        "install.ps1",
        "release-please-config.json",
        ".release-please-manifest.json"
      ]
    }
  }
}
